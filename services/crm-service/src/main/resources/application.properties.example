spring.application.name=crm-service
server.port=${SERVER_PORT:8082}

# Copy this file to application.properties and fill in real values.
# application.properties is gitignored — do not commit secrets.
#
# Neon shared team database (pooled JDBC):
# jdbc:postgresql://<host>/<database>?sslmode=require&prepareThreshold=0
#
# You can also override with env vars: DB_URL, DB_USER, DB_PASSWORD

spring.datasource.url=${DB_URL:jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&prepareThreshold=0}
spring.datasource.username=${DB_USER:neondb_owner}
spring.datasource.password=${DB_PASSWORD:YOUR_NEON_PASSWORD}

# Flyway owns schema; Hibernate does not mutate DDL
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true
logging.level.org.springframework.web=DEBUG
logging.level.org.flywaydb=INFO

# Auth mode: keycloak (ERP standard, default) | legacy (local auth-service HS256)
crm.security.auth-mode=${CRM_AUTH_MODE:keycloak}

# Keycloak OAuth2 resource server (issuer must match token "iss")
spring.security.oauth2.resourceserver.jwt.issuer-uri=${KEYCLOAK_ISSUER_URI:http://localhost:8080/realms/erp}

# Legacy HS256 (only when crm.security.auth-mode=legacy)
crm.security.jwt.secret=${JWT_SECRET:Y3JtLWp3dC1zZWNyZXQtaW5zYS1lcnAtcGhhc2UtMS1rZXktMjAyNg==}
crm.security.jwt.expiration-ms=${JWT_EXPIRATION_MS:900000}
crm.security.jwt.blacklist-enabled=${REDIS_BLACKLIST_ENABLED:false}
crm.security.jwt.blacklist-fail-closed=${REDIS_BLACKLIST_FAIL_CLOSED:true}

# Redis (optional; used by legacy JWT blacklist)
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}

# RabbitMQ (docker compose up -d rabbitmq)
spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USER:crm}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:crm123}

# Cross-module HTTP integrations (WebClient)
crm.integration.auth.base-url=${AUTH_SERVICE_URL:http://localhost:8081}
crm.integration.auth.enabled=true
crm.integration.hrm.base-url=${HRM_SERVICE_URL:http://localhost:8091}
crm.integration.hrm.enabled=true
crm.integration.hrm.allow-fallback=${INTEGRATION_ALLOW_FALLBACK:true}
crm.integration.mms.base-url=${MMS_SERVICE_URL:http://localhost:8092}
crm.integration.mms.enabled=true
crm.integration.mms.allow-fallback=${INTEGRATION_ALLOW_FALLBACK:true}
crm.integration.fms.base-url=${FMS_SERVICE_URL:http://localhost:8093}
crm.integration.fms.enabled=true
crm.integration.fms.allow-fallback=${INTEGRATION_ALLOW_FALLBACK:true}
crm.integration.connect-timeout-ms=3000
crm.integration.read-timeout-ms=5000

# Notifications — email via SMTP; SMS off for now
crm.notification.email.enabled=true
crm.notification.email.from=${CRM_MAIL_FROM:crm-noreply@insa.local}
crm.notification.email.allow-log-fallback=${CRM_MAIL_LOG_FALLBACK:true}
crm.notification.sms.enabled=false
crm.notification.sms.provider=log
crm.notification.default-email=${CRM_NOTIFY_EMAIL:ops@crm.local}
crm.notification.default-sms=+10000000000

# SMTP (required for real email delivery)
spring.mail.host=${SMTP_HOST:smtp.example.com}
spring.mail.port=${SMTP_PORT:587}
spring.mail.username=${SMTP_USERNAME:}
spring.mail.password=${SMTP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# Actuator / Observability
management.endpoints.web.exposure.include=health,info,prometheus
management.endpoint.health.show-details=always
management.endpoint.health.probes.enabled=true
management.health.db.enabled=true
management.health.rabbit.enabled=true
management.health.mail.enabled=true
management.info.env.enabled=true
info.app.name=crm-service
info.app.description=INSA CRM microservice (Keycloak OAuth2 resource server)
info.app.version=0.0.1-SNAPSHOT

# SpringDoc OpenAPI
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

# Correlation / logging
crm.observability.correlation-header=X-Correlation-Id

# CORS (comma-separated; avoid *)
crm.cors.allowed-origins=${CRM_CORS_ORIGINS:http://localhost:3000,http://localhost:5173}

# Lead auto-assignment: territory manager first, else round-robin officers
crm.lead.assignment.enabled=${CRM_LEAD_ASSIGNMENT_ENABLED:true}
crm.lead.assignment.officers=${CRM_LEAD_ASSIGNMENT_OFFICERS:sales}
