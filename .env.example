# ============================================================================
# INSA-ERP — environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# ============================================================================

# ---------------------------------------------------------------------------
# Neon Postgres — application services (the 5 Spring Boot modules)
# ---------------------------------------------------------------------------
# Get this from your Neon dashboard -> Connect.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Neon requires SSL, so keep `?sslmode=require`.
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# MMS service local PostgreSQL and HTTP ports
MMS_DATABASE_PASSWORD=mms
MMS_DATABASE_PORT=5433
MMS_PORT=8081

# Local Postgres containers for the other modules (docker-compose `*-db`
# services). Used instead of Neon when a module's Spring service runs on the
# host; each port matches that service's default datasource so no env override
# is needed except where noted.
#
#   hrm   DATABASE_URL=jdbc:postgresql://localhost:5431/hrm?currentSchema=hrm_schema
#         (hrm reads DATABASE_URL, not a *-PORT var)
#   prms  POSTGRES_HOST/POSTGRES_PORT/POSTGRES_DB — uses 5432 by default, but
#         this compose exposes prms-db on 5435 (5432 is commonly held by another
#         Postgres); run the service with POSTGRES_PORT=5435 to use compose.
#   fms   FMS_DATABASE_URL default jdbc:postgresql://localhost:5434/fms
#   crm   copy application.properties.example -> application.properties and set
#         DB_URL=jdbc:postgresql://localhost:5436/crm
HRM_DATABASE_PASSWORD=hrm
HRM_DATABASE_PORT=5431
PRMS_DATABASE_PASSWORD=postgres
PRMS_DATABASE_PORT=5435
FMS_DATABASE_PASSWORD=fms
FMS_DATABASE_PORT=5434
CRM_DATABASE_PASSWORD=crm
CRM_DATABASE_PORT=5436

# Demo-mode write access: the UI (NEXT_PUBLIC_AUTH_MODE=demo) talks to the
# services over plain HTTP without Keycloak tokens. FMS dev-auth is on by
# default (FMS_DEV_AUTH=true) and HRM auth is disabled by default; enable MMS's
# dev-auth so its demo-mode writes are accepted:
MMS_DEV_AUTH=true

# ---------------------------------------------------------------------------
# Keycloak database (LOCAL Postgres container — NOT Neon)
# ---------------------------------------------------------------------------
# Keycloak stores realms/users/sessions in its own containerized Postgres
# (see docker-compose.yml service `keycloak-db`). Neon is a poor fit for
# Keycloak's schema bootstrap (long migration transactions get terminated).
# You only need to set a password; user/db/host are fixed in compose.
KEYCLOAK_DB_PASSWORD=keycloak

# ---------------------------------------------------------------------------
# Keycloak — admin bootstrap (Keycloak 26+ variable names)
# ---------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-in-dev
KC_HOSTNAME=localhost
KEYCLOAK_PORT=8080

# ---------------------------------------------------------------------------
# Realm / clients (must match keycloak/realm-export.json)
# ---------------------------------------------------------------------------
KEYCLOAK_REALM=erp
# OIDC issuer the Spring resource servers and Next.js frontend validate tokens against:
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/erp
# Public client used by the Next.js frontend (auth-code + PKCE, no secret):
KEYCLOAK_FRONTEND_CLIENT_ID=erp-frontend
# Confidential client used for service-to-service / token exchange:
KEYCLOAK_BACKEND_CLIENT_ID=erp-backend
# Regenerate this secret in the Keycloak admin console after first import:
KEYCLOAK_BACKEND_CLIENT_SECRET=replace-me-after-first-import

# ---------------------------------------------------------------------------
# Frontend (Next.js + Auth.js) — used by the `frontend` service in docker-compose
# ---------------------------------------------------------------------------
# The confidential erp-frontend client's secret. Auth.js sends it server-side for
# the password grant; without it every login fails with unauthorized_client.
# Copy from Keycloak: Clients -> erp-frontend -> Credentials -> Client secret
KEYCLOAK_FRONTEND_CLIENT_SECRET=replace-me-from-keycloak
# Session-cookie encryption key for Auth.js v5. Generate with: npx auth secret
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000

# Local browser access without Keycloak credentials. Change to "keycloak" only
# when KEYCLOAK_FRONTEND_CLIENT_SECRET matches the Keycloak client secret.
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_MMS_API_URL=http://localhost:8081

# Backend service base URLs the frontend calls (server-side only).
HRM_API_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# RabbitMQ — event bus (services: rabbitmq) used by CRM/PRMS
# ---------------------------------------------------------------------------
# Spring AMQP clients connect on the compose network at `rabbitmq:5672`, or on
# the host at the mapped ports below. The default credentials (guest/guest) match
# the PRMS defaults; the CRM service's example config uses crm/crm123 — override
# RABBITMQ_DEFAULT_USER/PASS here and align RABBITMQ_USER/RABBITMQ_PASSWORD in the
# service configs if you use CRM's non-default credentials.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
