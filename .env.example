# ============================================================================
# INSA-ERP — environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# ============================================================================

# ---------------------------------------------------------------------------
# Neon Postgres — application services (the 5 Spring Boot modules)
# ---------------------------------------------------------------------------
# Get this from your Neon dashboard -> Connect.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Neon requires SSL, so keep `?sslmode=require`.
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Keycloak database (LOCAL Postgres container — NOT Neon)
# ---------------------------------------------------------------------------
# Keycloak stores realms/users/sessions in its own containerized Postgres
# (see docker-compose.yml service `keycloak-db`). Neon is a poor fit for
# Keycloak's schema bootstrap (long migration transactions get terminated).
# You only need to set a password; user/db/host are fixed in compose.
KEYCLOAK_DB_PASSWORD=keycloak

# ---------------------------------------------------------------------------
# Keycloak — admin bootstrap (Keycloak 26+ variable names)
# ---------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-in-dev
KC_HOSTNAME=localhost
KEYCLOAK_PORT=8080

# ---------------------------------------------------------------------------
# Realm / clients (must match keycloak/realm-export.json)
# ---------------------------------------------------------------------------
KEYCLOAK_REALM=erp
# OIDC issuer the Spring resource servers and Next.js frontend validate tokens against:
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/erp
# Public client used by the Next.js frontend (auth-code + PKCE, no secret):
KEYCLOAK_FRONTEND_CLIENT_ID=erp-frontend
# Confidential client used for service-to-service / token exchange:
KEYCLOAK_BACKEND_CLIENT_ID=erp-backend
# Regenerate this secret in the Keycloak admin console after first import:
KEYCLOAK_BACKEND_CLIENT_SECRET=replace-me-after-first-import

# ---------------------------------------------------------------------------
# Frontend (Next.js + Auth.js) — used by the `frontend` service in docker-compose
# ---------------------------------------------------------------------------
# The confidential erp-frontend client's secret. Auth.js sends it server-side for
# the password grant; without it every login fails with unauthorized_client.
# Copy from Keycloak: Clients -> erp-frontend -> Credentials -> Client secret
KEYCLOAK_FRONTEND_CLIENT_SECRET=replace-me-from-keycloak
# Session-cookie encryption key for Auth.js v5. Generate with: npx auth secret
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000

# Backend service base URLs the frontend calls (server-side only).
HRM_API_URL=http://localhost:8081
