# ============================================================================
# INSA-ERP frontend — environment (EXAMPLE)
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# ============================================================================

# Auth.js session-encryption secret. Generate one with:
#   npx auth secret        (or)   openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Required for local dev (no reverse proxy in front of Next.js):
AUTH_TRUST_HOST=true

# ---- Keycloak (erp realm, erp-frontend client) ----
KEYCLOAK_ISSUER=http://localhost:8080/realms/erp
KEYCLOAK_CLIENT_ID=erp-frontend
# Copy this from Keycloak: Clients -> erp-frontend -> Credentials -> Client secret
KEYCLOAK_CLIENT_SECRET=replace-me-from-keycloak

# ---- CRM microservice (Team 4) ----
# Server-side calls from Next.js → Spring CRM (default local port).
CRM_API_BASE_URL=http://localhost:8082

# ---- FMS microservice (Financial Management) ----
# Server-side calls from Next.js → Spring FMS (default local port).
FMS_API_BASE_URL=http://localhost:8084
# Client-side calls (browser) from Next.js → Spring FMS (default local port).
NEXT_PUBLIC_FMS_API_URL=http://localhost:8084

# ---- Demo mode ----
# Set to "demo" to use mock data without backend
NEXT_PUBLIC_AUTH_MODE=demo
